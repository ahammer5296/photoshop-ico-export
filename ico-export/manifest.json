{
  "manifestVersion": 5,
  "id": "com.local.icoexport",
  "name": "ICO Export",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "icoExport",
      "label": { "default": "ICO Export" },
      "minimumSize": { "width": 230, "height": 260 },
      "preferredDockedSize": { "width": 260, "height": 320 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
